{
  "id": "vrage",
  "componentId": "game-performance",
  "url": "https://your-game-server.example/vrageremote/v1/server",
  "keyEnv": "VRAGE_KEY",
  "intervalSeconds": 30,
  "ttlSeconds": 120,
  "retentionDays": 7,
  "port": 8790,
  "policy": {
    "enabled": false,
    "metricId": "simulation_speed",
    "readyMetric": "ready",
    "below": 0.8,
    "recoverAbove": 0.95,
    "badForSeconds": 90,
    "recoveryForSeconds": 120,
    "sourceId": "game-performance-telemetry",
    "sourceName": "Native game performance rule",
    "component": {
      "id": "game-performance",
      "parent_id": "your-product",
      "name": "Game performance",
      "kind": "service",
      "critical": false,
      "fallback_status": "operational",
      "launched": true,
      "launched_set": true
    },
    "alertTitle": "Server is slow \u2014 expect lag",
    "alertSummary": "Simulation speed stayed below the configured threshold. The game is responding, but simulation performance is degraded."
  },
  "adapter": "game-server/space-engineers"
}
