---
/**
 * Public status layout — one design, scope-driven branding.
 * Sets `data-scope` on <html> (from the host-derived scope, fixed per domain)
 * which the CSS uses to swap accent + wordmark + logo. `data-theme` drives
 * light/dark (persisted; default light, no prefers-color-scheme, matching the
 * company brand site). <body data-skinned> activates styles/skins.css;
 * admin uses AdminShell.astro and is untouched.
 */
import { scopeId, brandForScope } from '../lib/skin';
import { COMPANY_LEGAL, FOOTER_DOMAINS, THEME_STORAGE_KEY } from '../pulse.config';

import '../styles/tokens.css';
import '../styles/skins.css';
import '../styles/brand.css';

interface Props {
  title?: string;
  description?: string;
  /** Host-derived scope (null = umbrella (top-level)). */
  scope: string | null;
}

const { title = 'Status', description = 'Service status', scope } = Astro.props;
const sid = scopeId(scope);
const brand = brandForScope(scope);
---
<!DOCTYPE html>
<html lang="en" data-scope={sid} data-theme-key={THEME_STORAGE_KEY}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="alternate" type="application/atom+xml" title="Incident Feed" href="/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () { try { var k = document.documentElement.dataset.themeKey; if (localStorage.getItem(k) === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {} })();
  </script>
</head>
<body data-skinned>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/">
        <span class="chip"><img class="logomark" src={brand.logo} alt={brand.wordmark} /></span>
        {brand.wordmark}<span class="sub">/ status</span>
      </a>
      <span class="sp"></span>
      <a class="nav" href="/history">History</a>
      <button class="tt" onclick="toggleTheme()" aria-label="Toggle theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19"/></svg>
      </button>
    </div>
  </header>

  <main class="main">
    <div class="wrap"><slot /></div>
  </main>

  <footer>
    <div class="wrap">
      <div>All times UTC</div>
      <div class="dom">{COMPANY_LEGAL} · {FOOTER_DOMAINS.join(' · ')}</div>
    </div>
  </footer>

  <script is:inline>
    function toggleTheme() {
      var d = document.documentElement, k = d.dataset.themeKey, dark = d.getAttribute('data-theme') === 'dark';
      if (dark) { d.removeAttribute('data-theme'); try { localStorage.setItem(k, 'light'); } catch (e) {} }
      else { d.setAttribute('data-theme', 'dark'); try { localStorage.setItem(k, 'dark'); } catch (e) {} }
    }
  </script>
</body>
</html>
