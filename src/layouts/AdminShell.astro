---
/**
 * Generic resource-driven admin shell — list → detail → form lives in <slot/>.
 *
 * The layout is product-agnostic (the reusable CMS seed): a left sidebar of
 * resources (from the declarations) + a main pane for the active resource's
 * list / detail / form. Visual identity matches the public status skin: white
 * blueprint + isometric hatch, IBM Plex Sans + Mono, green accent, the locked
 * status palette — a property scope selector + per-resource counts.
 */
import { NAV_RESOURCES } from '@/lib/admin/resources';
import { COMPANY, SITE_TITLE } from '@/pulse.config';

interface NavCount { [key: string]: number | undefined; }

interface Props {
  title: string;
  active: string;             // active resource key
  adminEmail?: string;
  counts?: NavCount;          // optional badge counts per resource key
  property?: string;          // current property scope value
  properties?: { value: string; label: string }[];
  /** Primary action button in the top bar. `neutral` for declaring a problem. */
  primaryAction?: { href: string; label: string; variant?: 'pri' | 'neutral' };
  secondaryAction?: { href: string; label: string };
}

const {
  title,
  active,
  adminEmail = 'admin',
  counts = {},
  property = 'all',
  properties = [{ value: 'all', label: `All — ${COMPANY} root` }],
  primaryAction,
  secondaryAction,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — {SITE_TITLE} Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <aside>
    <div class="logo"><span class="flask"><b></b></span><div>Status<div class="sub">admin</div></div></div>
    <div class="prop">
      <label>Property</label>
      <form method="GET" id="propForm">
        <select id="prop" name="property" onchange="document.getElementById('propForm').submit()">
          {properties.map((p) => (
            <option value={p.value} selected={p.value === property}>{p.label}</option>
          ))}
        </select>
      </form>
    </div>
    <nav>
      {NAV_RESOURCES.map((r) => (
        <a class:list={[{ on: r.key === active }]} href={`/admin/${r.key === 'dashboard' ? '' : r.key}`}>
          <span class="ic"></span>{r.labelPlural}
          {counts[r.key] !== undefined && <span class="ct">{counts[r.key]}</span>}
        </a>
      ))}
    </nav>
    <div class="who">
      signed in · {adminEmail}
      <form method="POST" action="/api/admin/logout" style="margin-top:8px;">
        <button type="submit" class="signout">Sign out</button>
      </form>
    </div>
  </aside>

  <main>
    <div class="bar">
      <h1>{title}</h1>
      <div class="sp"></div>
      <a href="/" target="_blank" class="btn">View page</a>
      {secondaryAction && <a class="btn" href={secondaryAction.href}>{secondaryAction.label}</a>}
      {primaryAction && <a class:list={['btn', primaryAction.variant === 'neutral' ? null : 'pri']} href={primaryAction.href}>{primaryAction.label}</a>}
    </div>
    <div class="body"><slot /></div>
  </main>

<style is:global>
:root{
  --bg:#fafafa;--bg2:#f4f5f3;--card:#fff;--card2:#f6f7f4;--line:#e3e1d6;--line2:#d2cfc0;
  --txt:#14160e;--muted:#51564a;--faint:#8c9081;--accent:#0f7a29;--accent-mute:rgba(15,122,41,.10);
  --mono:'IBM Plex Mono',ui-monospace,monospace;--sans:'IBM Plex Sans',system-ui,sans-serif;
  --ok:#198754;--maint:#0d6efd;--degr:#cc9a06;--part:#fd7e14;--major:#dc3545; /* bootstrap palette (blue=info) */
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--txt);font-family:var(--sans);-webkit-font-smoothing:antialiased;display:flex;min-height:100vh;
  background-image:repeating-linear-gradient(30deg,transparent 0 39px,rgba(20,20,20,.04) 39px 40px),repeating-linear-gradient(-30deg,transparent 0 39px,rgba(20,20,20,.04) 39px 40px)}
.mono{font-family:var(--mono)}
input,select,textarea,button{font-family:inherit}
a{color:inherit;text-decoration:none}

aside{width:232px;flex:none;background:var(--bg2);border-right:1px solid var(--line);
  display:flex;flex-direction:column;position:sticky;top:0;height:100vh}
.logo{display:flex;align-items:center;gap:10px;padding:18px 18px;border-bottom:1px solid var(--line);font-weight:700}
.flask{width:26px;height:26px;border-radius:7px;background:#0b0e0a;border:1px solid var(--line2);display:grid;place-items:center}
.flask b{width:11px;height:11px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:var(--accent);box-shadow:0 0 10px var(--accent)}
.logo .sub{font-family:var(--mono);font-size:11px;color:var(--faint);font-weight:500}
.prop{padding:13px 18px;border-bottom:1px solid var(--line)}
.prop label{font-family:var(--mono);font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.12em;display:block;margin-bottom:6px}
.prop select{width:100%;background:var(--card);border:1px solid var(--line2);color:var(--txt);font-family:var(--mono);font-size:12.5px;padding:8px 10px;border-radius:8px}
nav{padding:10px 10px;flex:1}
nav a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:9px;color:var(--muted);
  font-size:14px;font-weight:500;margin-bottom:2px;cursor:pointer}
nav a:hover{background:var(--card);color:var(--txt)}
nav a.on{background:var(--accent-mute);color:var(--txt);box-shadow:inset 2px 0 0 var(--accent)}
nav a .ic{width:7px;height:7px;border-radius:2px;background:currentColor;opacity:.7}
nav a .ct{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--faint)}
nav a.on .ct{color:var(--accent)}
.who{padding:14px 18px;border-top:1px solid var(--line);font-family:var(--mono);font-size:11px;color:var(--faint)}
.who .signout{background:none;border:none;color:var(--faint);font-family:var(--mono);font-size:11px;cursor:pointer;padding:0;text-decoration:underline}
.who .signout:hover{color:var(--txt)}

main{flex:1;min-width:0;display:flex;flex-direction:column}
.bar{display:flex;align-items:center;gap:14px;padding:16px 26px;border-bottom:1px solid var(--line);
  position:sticky;top:0;background:rgba(250,250,250,.85);backdrop-filter:blur(8px);z-index:5}
.bar h1{font-size:18px;font-weight:700;letter-spacing:-.02em}
.bar .sp{flex:1}
.btn{font-family:var(--mono);font-size:12.5px;font-weight:600;padding:9px 14px;border-radius:9px;cursor:pointer;border:1px solid var(--line2);background:var(--card);color:var(--txt);display:inline-block}
.btn:hover{border-color:var(--accent)}
.btn.pri{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn.danger{border-color:var(--major);color:var(--major);background:rgba(207,47,55,.07)}
.body{padding:24px 26px;max-width:1000px;width:100%}

.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:22px}
.kpi{border:1px solid var(--line);border-radius:13px;background:var(--card);padding:15px 16px}
.kpi .n{font-size:28px;font-weight:700;letter-spacing:-.02em}
.kpi .l{font-family:var(--mono);font-size:11px;color:var(--faint);text-transform:uppercase;letter-spacing:.1em;margin-top:3px}
.kpi .l.bad{color:var(--major)}

.seclbl{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin:24px 0 11px;display:flex;align-items:center;gap:10px}
.seclbl::after{content:"";flex:1;height:1px;background:var(--line)}
.seclbl:first-child{margin-top:0}

.tbl{border:1px solid var(--line);border-radius:13px;overflow:hidden;background:var(--card)}
.tr{display:grid;gap:12px;align-items:center;padding:13px 16px;border-bottom:1px solid var(--line);font-size:14px}
.tr.link{cursor:pointer}
.tr:last-child{border-bottom:0}
.tr.link:hover{background:var(--card2)}
.tr.head{background:var(--bg2);font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--faint)}
.tr .t{font-weight:600;letter-spacing:-.01em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pill{font-family:var(--mono);font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;padding:3px 8px;border-radius:5px;display:inline-block;white-space:nowrap}
.muted{font-family:var(--mono);font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chev{color:var(--faint);text-align:center}
.tabs{display:flex;gap:6px;margin-bottom:14px}
.tabs a,.tabs button{font-family:var(--mono);font-size:12px;padding:7px 13px;border-radius:8px;border:1px solid var(--line2);background:transparent;color:var(--muted);cursor:pointer;text-decoration:none}
.tabs a.on,.tabs button.on{background:var(--accent-mute);color:var(--txt);border-color:var(--accent)}

.form{border:1px solid var(--line2);border-radius:13px;background:var(--card);padding:20px;max-width:620px}
.fld{margin-bottom:15px}
.fld label{font-family:var(--mono);font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:7px}
.fld input[type=text],.fld input[type=number],.fld input[type=datetime-local],.fld input[type=email],.fld select,.fld textarea{width:100%;background:#fff;border:1px solid var(--line2);color:var(--txt);font-size:14px;padding:10px 12px;border-radius:9px}
.fld textarea{min-height:90px;resize:vertical;font-family:var(--sans)}
.fld.row{display:flex;gap:13px}.fld.row>div{flex:1}
.fld .check{display:flex;align-items:center;gap:.5em;font-size:14px;cursor:pointer;margin-top:.35em;font-family:var(--sans);text-transform:none;letter-spacing:0;color:var(--txt)}
.note{font-family:var(--mono);font-size:11px;color:var(--faint);margin-top:6px;line-height:1.5}
.err{font-family:var(--mono);font-size:12px;color:var(--major);margin-bottom:14px}
.banner{border:1px solid var(--accent);background:var(--accent-mute);border-radius:11px;padding:14px 16px;margin-bottom:20px;font-size:13px}
.banner code{font-family:var(--mono);font-size:12px;word-break:break-all;user-select:all;display:block;margin-top:8px;color:var(--txt)}

.timeline{font-family:var(--mono);font-size:12.5px;color:var(--muted);line-height:1.7}
.timeline .ev{padding:10px 0;border-bottom:1px solid var(--line)}
.timeline .ev:last-child{border-bottom:0}
.timeline .ev b{font-weight:600}
.timeline .ev .ts{color:var(--faint)}

@media(max-width:760px){aside{display:none}.kpis{grid-template-columns:repeat(2,1fr)}}
</style>
</body>
</html>
