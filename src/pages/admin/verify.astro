---
import {
  consumeMagicLink,
  consumeMagicLinkWithOwner,
  createSession,
  createSessionWithOwner,
  signCookie,
  COOKIE_NAME,
} from '@/lib/admin-auth';
import { pulpOwnerRouteFamilyConfigured } from '@/lib/pulp-bridge';
import { SITE_TITLE } from '@/pulse.config';

const token = Astro.url.searchParams.get('token');
let error = '';

if (token) {
  const ownerEnabled = pulpOwnerRouteFamilyConfigured('auth');
  const ownerChallenge = ownerEnabled ? await consumeMagicLinkWithOwner(token) : null;
  const email = ownerEnabled ? null : await consumeMagicLink(token);
  if (ownerChallenge || email) {
    const sessionId = ownerChallenge
      ? await createSessionWithOwner(ownerChallenge.challengeId, ownerChallenge.identityId)
      : await createSession(email!);
    const secret = process.env.ADMIN_SESSION_SECRET ?? '';
    const signed = signCookie(sessionId, secret);
    Astro.cookies.set(COOKIE_NAME, signed, {
      path: '/',
      httpOnly: true,
      secure: Astro.url.protocol === 'https:', // local http dev can't store Secure cookies
      sameSite: 'lax',
      maxAge: 7 * 24 * 60 * 60,
    });
    return Astro.redirect('/admin');
  } else {
    error = 'This link has expired or has already been used. Request a new one.';
  }
} else {
  error = 'No token provided.';
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify — {SITE_TITLE} Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{min-height:100vh;display:grid;place-items:center;padding:20px;background:#fafafa;color:#14160e;
      font-family:'IBM Plex Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;
      background-image:repeating-linear-gradient(30deg,transparent 0 39px,rgba(20,20,20,.04) 39px 40px),repeating-linear-gradient(-30deg,transparent 0 39px,rgba(20,20,20,.04) 39px 40px)}
    .card{width:100%;max-width:380px;background:#fff;border:1px solid #d2cfc0;border-radius:14px;padding:30px 28px;text-align:center}
    .mark{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:17px;margin-bottom:16px}
    .chip{width:30px;height:30px;border-radius:8px;background:#0b0e0a;display:grid;place-items:center}
    .chip b{width:12px;height:12px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:#50e050;box-shadow:0 0 9px #50e050}
    .sub{font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8c9081;font-weight:500}
    h1{font-size:20px;font-weight:700;letter-spacing:-.02em;margin:4px 0 4px}
    .lead{color:#51564a;font-size:14px;margin-bottom:20px}
    a.btn{display:inline-block;background:#0f7a29;color:#fff;border-radius:9px;padding:11px 18px;font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600}
    a.btn:hover{background:#1ea63a}
  </style>
</head>
<body>
  <div class="card">
    <div class="mark"><span class="chip"><b></b></span>Status<span class="sub">/ admin</span></div>
    <h1>Login failed</h1>
    <p class="lead">{error}</p>
    <a class="btn" href="/admin/login">Request a new link</a>
  </div>
</body>
</html>
