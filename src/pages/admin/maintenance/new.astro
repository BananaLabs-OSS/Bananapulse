---
/**
 * Schedule maintenance — generic form from the maintenance declaration.
 */
import AdminShell from '@/layouts/AdminShell.astro';
import ResourceForm from '@/components/admin/ResourceForm.astro';
import { db } from '@/db';
import { maintenance } from '@/db/schema';
import { nanoid } from 'nanoid';
import { getResource } from '@/lib/admin/resources';
import { componentExists, isLeafComponent } from '@/lib/components';
import { notifyMaintenance } from '@/lib/notify';
import { componentOptions } from '@/lib/admin/view';
import { navCounts, propertyOptions } from '@/lib/admin/nav';
import { pulpOwnerRouteFamilyConfigured } from '@/lib/pulp-bridge';
import {
  ownerCommandID,
  ownerMaintenanceProjection,
  ownerNowUnix,
  sendOwnerMaintenanceCommand,
  toUnixSeconds,
} from '@/pages/api/v1/maintenance/owner';

const resource = getResource('maintenance')!;
const adminEmail = (Astro.locals as App.Locals).adminEmail ?? 'admin';
const ownerMode = pulpOwnerRouteFamilyConfigured('maintenance');
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = form.get('title')?.toString() ?? '';
  const summary = form.get('summary')?.toString() ?? '';
  const kind = form.get('kind')?.toString() || 'scheduled';
  const start = form.get('scheduledStart')?.toString() ?? '';
  const end = form.get('scheduledEnd')?.toString() ?? '';
  const affects = form.getAll('affects').map((a) => a.toString()).filter(Boolean);

  let unknown = '';
  if (ownerMode) {
    const projection = await ownerMaintenanceProjection();
    const components = new Map((projection.components ?? []).map(({ component }) => [component.id, component]));
    for (const a of affects) {
      const component = components.get(a);
      if (!component || component.archived || (component.kind !== 'service' && component.kind !== 'host')) {
        unknown = a;
        break;
      }
    }
  } else {
    for (const a of affects) {
      if (!(await componentExists(a)) || !(await isLeafComponent(a))) { unknown = a; break; }
    }
  }

  if (!title || !summary || !start || !end || affects.length === 0) {
    error = 'All fields are required, including at least one affected component.';
  } else if (unknown) {
    error = `Unknown or non-leaf component "${unknown}".`;
  } else {
    const newId = nanoid();
    if (ownerMode) {
      const now = ownerNowUnix();
      await sendOwnerMaintenanceCommand({
        version: 'monitor.v1',
        id: ownerCommandID('maintenance-admin-page-create', newId),
        kind: 'schedule_maintenance',
        at_unix: now,
        maintenance: {
          id: newId, title, summary, kind,
          scheduled_start_unix: toUnixSeconds(new Date(start)),
          scheduled_end_unix: toUnixSeconds(new Date(end)),
          affects, created_at_unix: now,
        },
      });
    } else {
      await db.insert(maintenance).values({
        id: newId, title, summary, kind,
        scheduledStart: new Date(start), scheduledEnd: new Date(end), affects,
      });
      await notifyMaintenance(newId, 'announced'); // email subscribers (best-effort, self-guarded)
    }
    // (Instances may hook emergency windows here — e.g. light up an external banner.)
    return Astro.redirect('/admin/maintenance');
  }
}

// Quick presets: ?preset=tuesday prefills the weekly Tuesday-evening window;
// ?preset=emergency prefills an immediate emergency window. User still confirms.
const preset = Astro.url.searchParams.get('preset');
let record: Record<string, unknown> = {};
if (Astro.request.method !== 'POST' && preset) {
  const now = new Date();
  if (preset === 'emergency') {
    record = { kind: 'emergency', title: 'Emergency maintenance',
      summary: 'Applying an urgent fix — brief disruption possible.',
      scheduledStart: now, scheduledEnd: new Date(now.getTime() + 60 * 60000) };
  } else if (preset === 'tuesday') {
    const t = new Date(now);
    t.setDate(now.getDate() + ((2 - now.getDay() + 7) % 7 || 7)); // next Tuesday
    t.setHours(22, 0, 0, 0);
    record = { kind: 'scheduled', title: 'Weekly platform maintenance',
      summary: 'Routine Tuesday-evening maintenance. Servers may restart briefly.',
      scheduledStart: t, scheduledEnd: new Date(t.getTime() + 60 * 60000) };
  }
}

const components = await componentOptions();
const counts = await navCounts();
const properties = await propertyOptions();
---
<AdminShell title="Schedule maintenance" active="maintenance" adminEmail={adminEmail} counts={counts} property="all" properties={properties}
  secondaryAction={{ href: '/admin/maintenance', label: '← All maintenance' }}>
  <ResourceForm resource={resource} mode="create" action="/admin/maintenance/new" record={record as any}
    dynamic={{ components }} error={error} submitLabel="Schedule" cancelHref="/admin/maintenance" />
</AdminShell>
