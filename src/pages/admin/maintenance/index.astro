---
/**
 * Maintenance list — scheduled planned windows. Inherently manual.
 */
import AdminShell from '@/layouts/AdminShell.astro';
import ResourceList from '@/components/admin/ResourceList.astro';
import { db } from '@/db';
import { maintenance } from '@/db/schema';
import { asc } from 'drizzle-orm';
import { getResource } from '@/lib/admin/resources';
import { navCounts, propertyOptions } from '@/lib/admin/nav';
import { fmtDateTime } from '@/lib/admin/view';

const resource = getResource('maintenance')!;
const adminEmail = (Astro.locals as App.Locals).adminEmail ?? 'admin';
const property = Astro.url.searchParams.get('property') ?? 'all';
const rows = await db.select().from(maintenance).orderBy(asc(maintenance.scheduledStart));
const counts = await navCounts();
const properties = await propertyOptions();
---
<AdminShell title="Maintenance" active="maintenance" adminEmail={adminEmail} counts={counts} property={property} properties={properties}
  primaryAction={{ href: '/admin/maintenance/new', label: '+ Schedule maintenance' }}>
  <p class="note" style="margin-bottom:16px">{resource.blurb}</p>
  <ResourceList resource={resource} rows={rows}
    hrefFor={(r) => `/admin/maintenance/${r.id}`}
    cellOverrides={Object.fromEntries(rows.flatMap((r) => [
      [`${r.id}|scheduledStart`, `<span class="muted">${fmtDateTime(r.scheduledStart)}</span>`],
      [`${r.id}|scheduledEnd`, `<span class="muted">${fmtDateTime(r.scheduledEnd)}</span>`],
    ]))}
    emptyText="No maintenance scheduled." />
</AdminShell>
