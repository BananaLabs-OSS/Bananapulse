---
/**
 * Add a component — generic form from the components declaration (adjacency
 * tree). Status is never set here; it's engine-derived.
 */
import AdminShell from '@/layouts/AdminShell.astro';
import ResourceForm from '@/components/admin/ResourceForm.astro';
import { createComponentRow, getComponentRow } from '@/lib/db-components';
import { componentExists } from '@/lib/components';
import { getResource, COMPONENT_KIND_OPTIONS } from '@/lib/admin/resources';
import { componentParentOptions } from '@/lib/admin/view';
import { navCounts, propertyOptions } from '@/lib/admin/nav';
import { monitorAdminCommand, monitorAdminOwnerConfigured, monitorOwnerProjection, ownerRequestID } from '@/pages/api/v1/admin/components/pulp-owner';

const KINDS = COMPONENT_KIND_OPTIONS.map((o) => o.value);
const resource = getResource('components')!;
const adminEmail = (Astro.locals as App.Locals).adminEmail ?? 'admin';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = (form.get('id')?.toString() ?? '').trim();
  const name = form.get('name')?.toString() ?? '';
  const kind = form.get('kind')?.toString() ?? '';
  const parentId = form.get('parentId')?.toString() || null;
  if (!id || !name || !kind) {
    error = 'ID, name and kind are required.';
  } else if (!/^[a-z0-9-]+$/.test(id)) {
    error = 'ID must be lowercase letters, numbers and dashes only.';
  } else if (!KINDS.includes(kind)) {
    error = `Kind must be one of: ${KINDS.join(', ')}.`;
  } else if (monitorAdminOwnerConfigured() && (await monitorOwnerProjection(true)).components.some(({ component }) => component.id === id)) {
    error = `A component with id "${id}" already exists.`;
  } else if (!monitorAdminOwnerConfigured() && await getComponentRow(id)) {
    error = `A component with id "${id}" already exists.`;
  } else if (parentId && monitorAdminOwnerConfigured() && !(await monitorOwnerProjection(false)).components.some(({ component }) => component.id === parentId)) {
    error = `Unknown parent component "${parentId}".`;
  } else if (parentId && !monitorAdminOwnerConfigured() && !(await componentExists(parentId))) {
    error = `Unknown parent component "${parentId}".`;
  } else {
    if (monitorAdminOwnerConfigured()) await monitorAdminCommand({
      id: ownerRequestID('admin-component-create', Astro.request, id), kind: 'upsert_component', component: {
        id, name, kind, parent_id: parentId || '', tag: form.get('tag')?.toString() || '',
        brand: form.get('brand')?.toString() || '', domain: form.get('domain')?.toString() || '',
        sort_order: parseInt(form.get('sortOrder')?.toString() ?? '0') || 0,
        fallback_status: 'operational', critical: false, launched: true, launched_set: true, archived: false,
      },
    }); else await createComponentRow({
      id, name, kind,
      parentId,
      tag: form.get('tag')?.toString() || null,
      brand: form.get('brand')?.toString() || null,
      domain: form.get('domain')?.toString() || null,
      sortOrder: parseInt(form.get('sortOrder')?.toString() ?? '0') || 0,
    });
    return Astro.redirect('/admin/components');
  }
}

const componentParents = await componentParentOptions();
const counts = await navCounts();
const properties = await propertyOptions();
---
<AdminShell title="Add component" active="components" adminEmail={adminEmail} counts={counts} property="all" properties={properties}
  secondaryAction={{ href: '/admin/components', label: '← All components' }}>
  <ResourceForm resource={resource} mode="create" action="/admin/components/new"
    dynamic={{ componentParents }} error={error} cancelHref="/admin/components" />
</AdminShell>
