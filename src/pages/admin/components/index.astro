---
/**
 * Components list — the tree leaves (services rows). Setup config; archive,
 * never delete. Note: no live-status column or control — component status is
 * derived by the engine, never hand-set here (status §5 discipline).
 */
import AdminShell from '@/layouts/AdminShell.astro';
import ResourceList from '@/components/admin/ResourceList.astro';
import { getComponentsAdmin } from '@/lib/db-components';
import { getResource } from '@/lib/admin/resources';
import { navCounts, propertyOptions } from '@/lib/admin/nav';
import { componentAdminRow, monitorAdminOwnerConfigured, monitorOwnerProjection } from '@/pages/api/v1/admin/components/pulp-owner';

const resource = getResource('components')!;
const adminEmail = (Astro.locals as App.Locals).adminEmail ?? 'admin';
const property = Astro.url.searchParams.get('property') ?? 'all';
const tab = Astro.url.searchParams.get('tab') ?? 'active';
const rows = monitorAdminOwnerConfigured()
  ? (await monitorOwnerProjection(true)).components.map(({ component }) => component)
    .filter((component) => Boolean(component.archived) === (tab === 'archived'))
    .sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0)).map(componentAdminRow)
  : await getComponentsAdmin({ archived: tab === 'archived' });
const counts = await navCounts();
const properties = await propertyOptions();
---
<AdminShell title="Components" active="components" adminEmail={adminEmail} counts={counts} property={property} properties={properties}
  primaryAction={{ href: '/admin/components/new', label: '+ Add component' }}>
  <p class="note" style="margin-bottom:16px">{resource.blurb}</p>
  <div class="tabs">
    {resource.tabs!.map((t) => (
      <a class:list={[{ on: t.value === tab }]} href={`/admin/components?tab=${t.value}`}>{t.label}</a>
    ))}
  </div>
  <ResourceList resource={resource} rows={rows}
    hrefFor={(r) => `/admin/components/${r.id}`}
    emptyText={tab === 'archived' ? 'No archived components.' : 'No components yet.'} />
</AdminShell>
