---
/**
 * Public node view — one route for the whole component tree at any depth.
 * The URL is relative to the entry domain's landing root (the scope), so:
 *   status.example.com/team/provisioner   (umbrella root)
 *   status.team.example.com/provisioner   (root = a product)
 * Reuses the skin; the tree + rollup come from lib/components.
 */
import Skin from '../layouts/Skin.astro';
import ScopeView from '../components/skin/ScopeView.astro';
import NotFound from '../components/skin/NotFound.astro';
import { buildComponentView } from '../lib/components';
import { getMonitorProjection, pulpMonitorProjectionConfigured } from '../lib/pulp-bridge';
import { buildPulpComponentView } from '../lib/pulp-monitor-projection';
import { singleChildDestination } from '../lib/single-child-view';
import { COMPANY } from '../pulse.config';

const scope = (Astro.locals as any).scope as string | null;
const raw = Astro.params.path;
const segs = raw ? raw.split('/').filter(Boolean) : [];
const ownerSelected = pulpMonitorProjectionConfigured();

let view = null;
let unavailable = false;
try {
  const projection = ownerSelected ? await getMonitorProjection() : null;
  const load = (segments: string[]) => projection
    ? buildPulpComponentView(projection, scope, segments)
    : buildComponentView(scope, segments);
  view = await load(segs);
  const destination = await singleChildDestination(view, Astro.url.pathname, load);
  if (destination) {
    const redirect = Astro.redirect(destination + Astro.url.search, 302);
    redirect.headers.set('Cache-Control', 'no-store');
    return redirect;
  }
} catch (_e) {
  unavailable = true;
  // A failed owner lookup is unavailable, not evidence of a missing page.
}
if (!view) Astro.response.status = unavailable ? 503 : 404;
if (unavailable) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Retry-After', '30');
}

const affectedPath = view ? view.crumbs.map((c) => c.label) : [];
---
<Skin scope={scope} title={view ? `${view.nodeName} Status` : unavailable ? 'Status unavailable' : 'Not found'}>
  {view
    ? <ScopeView view={view} scope={scope} companyName={COMPANY} affectedPath={affectedPath} />
    : <NotFound
        title={unavailable ? 'Status unavailable' : 'Not found'}
        message={unavailable
          ? 'Live status is temporarily unavailable. Please try again shortly.'
          : "That page doesn't exist on this status site."}
      />}
</Skin>
