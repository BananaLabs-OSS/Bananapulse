---
/**
 * Tappable breadcrumb — present at every level, including inside an open
 * incident, so you can jump up any number of levels in one tap.
 */
import type { CrumbItem } from '../../lib/view';

interface Props {
  crumbs: CrumbItem[];
}

const { crumbs } = Astro.props;
const path = crumbs.map((c) => c.label).join('/');
---
<div class="crumbs" data-path={path}>
  {crumbs.map((c, i) => (
    <>
      {c.href
        ? <a href={c.href}>{c.label}</a>
        : <a class="here">{c.label}</a>}
      {i < crumbs.length - 1 && <span class="sep">/</span>}
    </>
  ))}
</div>
