# Banana Pulse — environment variables

# Database — any vanilla Postgres (no vendor-specific features used)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Admin auth (magic-link login)
ADMIN_EMAIL=you@example.com
ADMIN_SESSION_SECRET=replace-with-random-64-char-string

# Email (Resend — admin magic links + incident notifications)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=status@example.com
RESEND_FROM_NAME=Example Co Status

# Shared secret for the dead-man sweep cron + the UptimeRobot ingest adapter (?key=...)
UPTIME_HOOK_SECRET=replace-with-random-shared-secret

# Optional vantages
# GRAFANA_HOOK_SECRET=shared-secret-for-grafana-webhook
# GRAFANA_HOOK_TTL_SECONDS=16200
# UPTIMEROBOT_API_KEY=read-only-api-key-for-the-poller

# Absolute site origin for feeds/permalinks (Netlify sets URL automatically;
# set SITE_URL on other hosts)
# SITE_URL=https://status.example.com
